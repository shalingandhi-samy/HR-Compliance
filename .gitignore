# Generated report HTML at repo root can contain real associate PII
# (names, WINs, managers) -- never commit these. templates/*.html are
# Jinja source templates (no data baked in) and stay tracked.
/*.html
*_out.txt

# Live MS Graph refresh token -- never commit credentials
.graph_token_cache.json

# One-off debug/dump scratch scripts from ad-hoc data investigations --
# often contain hardcoded real associate names copy-pasted for debugging.
debug_*.py
dump_*.py
_cwd_test.txt
all_excel_names.txt
all_sheets_names.txt
live_names_debug.txt
pts_dump.txt